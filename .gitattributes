# Never line-ending-convert binary files — a false-positive "text" guess
# on any of these would silently corrupt them.
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.zip binary
*.pptx binary
*.docx binary
*.xlsx binary
